# ===== GOOGLE CLOUD CONFIGURATION =====
# Your Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# Gemini API Key (for direct API access)
GEMINI_API_KEY=your-gemini-api-key

# ===== SERVER CONFIGURATION =====
# Port for the Flask backend server
PORT=5000

# Flask environment (development/production)
FLASK_ENV=development

# ===== VOICE CONFIGURATION =====
# Voice name to use for text-to-speech
# Options: en-US-Neural2-A (male), en-US-Neural2-C (female), en-US-Neural2-F (female)
VOICE_NAME=en-US-Neural2-F

# Language code
LANGUAGE_CODE=en-US

# Speaking rate (0.25 to 4.0, default 1.0)
SPEAKING_RATE=1.0

# Voice pitch (-20.0 to 20.0, default 0.0)
VOICE_PITCH=0.0
